<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.de-gupta</groupId>
        <artifactId>security.parent</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>security.bom</artifactId>
    <version>3.1.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>${project.artifactId}</name>
    <description>A Maven BOM for the commons-security libraries</description>
    <url>https://github.com/de-gupta/security.bom.git</url>

    <properties>
        <themis.version>4.0.1</themis.version>
        <hermes.version>3.0.1</hermes.version>
        <augustus.version>3.0.1</augustus.version>
        <argus.version>3.0.1</argus.version>
        <argus.spring.version>3.0.1</argus.spring.version>
        <janus.version>0.2.0</janus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.themis</artifactId>
                <version>${themis.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.hermes</artifactId>
                <version>${hermes.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.augustus</artifactId>
                <version>${augustus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.argus</artifactId>
                <version>${argus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.argus.spring</artifactId>
                <version>${argus.spring.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.janus</artifactId>
                <version>${janus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.janus.core</artifactId>
                <version>${janus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.janus.spring</artifactId>
                <version>${janus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.janus.spring.web</artifactId>
                <version>${janus.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.de-gupta</groupId>
                <artifactId>security.janus.idp.implementation</artifactId>
                <version>${janus.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <scm>
        <connection>scm:git:ssh://git@github.com/de-gupta/security.bom.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/de-gupta/security.bom.git</developerConnection>
        <url>https://github.com/de-gupta/security.bom.git</url>
        <tag>HEAD</tag>
    </scm>
</project>